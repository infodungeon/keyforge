# KeyForge Environment Variables (Example)
# Copy this to .env and adjust as needed.

# PostgreSQL Configuration
POSTGRES_USER=keyforge
POSTGRES_PASSWORD=forge_password
POSTGRES_DB=keyforge_hive

# Valkey Configuration
VALKEY_PASSWORD=dev_valkey_secret

# Hive Configuration
HIVE_SECRET=dev_hive_secret_key_32_chars_long_
