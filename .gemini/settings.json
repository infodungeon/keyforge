{
  "mcpServers": {
    "narsil": {
      "command": "python3",
      "args": ["ops/scripts/mcp_bridge.py", "/home/robert/.cargo/bin/narsil-mcp", "--repos", ".,/tmp/gemini-cli-audit", "--call-graph", "--persist", "--git"]
    },
    "arbor": {
      "command": "python3",
      "args": ["ops/scripts/mcp_bridge.py", "/home/robert/.cargo/bin/arbor", "bridge"]
    },
    "github": {
      "command": "python3",
      "args": ["ops/scripts/mcp_bridge.py", "github"],
      "env": { "KF_GH_AUTH_BLOB": "$KF_GH_AUTH_BLOB" }
    },
    "swarm": {
      "command": "python3",
      "args": ["ops/scripts/mcp_bridge.py", "ops/mcp/swarm_router.py"],
      "env": {
        "KF_STUDIO_KEY": "$KF_STUDIO_KEY",
        "GEMINI_CLI_GROQ_KEY": "$GEMINI_CLI_GROQ_KEY",
        "GEMINI_CLI_MISTRAL_KEY": "$GEMINI_CLI_MISTRAL_KEY",
        "GEMINI_CLI_CEREBRAS_KEY": "$GEMINI_CLI_CEREBRAS_KEY",
        "GEMINI_CLI_SAMBANOVA_KEY": "$GEMINI_CLI_SAMBANOVA_KEY",
        "GEMINI_CLI_NVIDIA_KEY": "$GEMINI_CLI_NVIDIA_KEY",
        "GEMINI_CLI_CLOUDFLARE_KEY": "$GEMINI_CLI_CLOUDFLARE_KEY",
        "GEMINI_CLI_CLOUDFLARE_ACCOUNT_ID": "$GEMINI_CLI_CLOUDFLARE_ACCOUNT_ID",
        "KF_GH_AUTH_BLOB": "$KF_GH_AUTH_BLOB"
      }
    }
  }
}
