{
  "mcpServers": {
    "narsil": {
      "command": "/home/robert/.cargo/bin/narsil-mcp",
      "args": [
        "--repos",
        "/home/robert/projects/keyforge",
        "--call-graph",
        "--persist",
        "--git"
      ]
    },
    "arbor": {
      "command": "/home/robert/.cargo/bin/arbor",
      "args": [
        "bridge",
        "/home/robert/projects/keyforge"
      ]
    },
    "github": {
      "command": "node",
      "args": [
        "/home/robert/.npm-global/lib/node_modules/@modelcontextprotocol/server-github/dist/index.js"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${KF_GH_AUTH_BLOB}"
      }
    }
  }
}