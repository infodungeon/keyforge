{
  "mcpServers": {
    "narsil": {
      "command": "python3",
      "args": [
        "ops/scripts/mcp_bridge.py",
        "/home/robert/.cargo/bin/narsil-mcp",
        "--repos",
        ".",
        "--call-graph",
        "--persist",
        "--git"
      ]
    },
    "arbor": {
      "command": "python3",
      "args": [
        "ops/scripts/mcp_bridge.py",
        "/home/robert/.cargo/bin/arbor",
        "bridge"
      ]
    },
    "github": {
      "command": "node",
      "args": [
        "/home/robert/.npm-global/lib/node_modules/@modelcontextprotocol/server-github/dist/index.js"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    }
  }
}
