services:
  # The Database
  db:
    image: postgres:16-alpine
    container_name: keyforge_db
    restart: always
    environment:
      POSTGRES_USER: keyforge
      POSTGRES_PASSWORD: forge_password
      POSTGRES_DB: keyforge_hive
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keyforge"]
      interval: 5s
      timeout: 5s
      retries: 5

  # The Application
  hive:
    build:
      context: .
      dockerfile: ops/Dockerfile.hive
    container_name: keyforge_hive
    restart: always
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://keyforge:forge_password@db:5432/keyforge_hive
      HIVE_SECRET: ${HIVE_SECRET:-}
      RUST_LOG: info,keyforge_hive=debug
    volumes:
      - ./data:/app/data

  # The Web server
  web:
    build:
      context: .
      dockerfile: ops/Dockerfile.web
    container_name: keyforge_web
    restart: always
    ports:
      - "0.0.0.0:80:80"
      - "0.0.0.0:443:443"
    volumes:
      - ./ops/hosts/sites:/usr/local/apache2/htdocs:ro
      - ./ops/hosts/certs:/etc/apache2/ssl:ro

volumes:
  postgres_data:
