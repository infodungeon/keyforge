# Stage 1: Chef (Compute Recipe)
FROM rust:slim-bookworm AS chef
WORKDIR /app
RUN cargo install cargo-chef
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 2: Builder (Cache Dependencies)
FROM rust:slim-bookworm AS builder
WORKDIR /app
# CHANGED: Added pkg-config
RUN apt-get update && apt-get install -y pkg-config libssl-dev curl make unzip && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef
COPY --from=chef /app/recipe.json recipe.json
# Build dependencies - this layer is cached until Cargo.lock changes
RUN cargo chef cook --release --recipe-path recipe.json

# Stage 3: Compiler (Build Source)
COPY . .
# SQLx Offline support
ENV SQLX_OFFLINE=true
COPY .sqlx .sqlx
RUN cargo build --release --bin keyforge-hive

# Stage 4: Runtime (Distroless)
# Using cc-debian12 includes libssl, libc, libgcc
FROM gcr.io/distroless/cc-debian12
WORKDIR /app
COPY --from=builder /app/target/release/keyforge-hive /app/keyforge-hive
# Create data dir in workdir (though distroless has limited fs ops, app creates subdirs in volume)
# Note: Distroless has no mkdir. The app must handle creating dirs in the volume, 
# OR we rely on Docker to create the mount point.
ENV RUST_LOG=info
ENV KEYFORGE_DATA_DIR=/app/data
EXPOSE 3000
ENTRYPOINT ["/app/keyforge-hive"]
